# Canary — every variable is optional. Without keys the agents run on published rules and record gaps.

# AI arguments for the Bull/Bear/Judge (fact-guarded). Without it: rule-based agents.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# RYO market tools for the live radar (hackathon-issued key, starts with ryo_mcp_)
RYO_MCP_KEY=
# RYO_MCP_URL=https://app-ryochan.com/api/mcp

# Live promoter posts for the radar's Multi-KOL watcher, from free public sources. All optional.
# SOCIAL_SOURCES=telegram,bluesky,reddit,farcaster   # default: all four; "off" turns it off
# TELEGRAM_CHANNELS=WatcherGuru,lookonchainchannel,thecryptoexpress,gem_tools_calls,WhaleBotAlerts,wublockchainenglish   # public channels (max 8)
# BSKY_APPVIEW_URL=https://api.bsky.app
# Reddit's robots.txt disallows scraping, so Reddit is read only through its official API (a free "script" app):
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# SUBREDDITS=CryptoMoonShots,SatoshiStreetBets,CryptoCurrency
# Farcaster casts through Neynar (its keyless endpoints disallow automated access):
# NEYNAR_API_KEY=

# Ethereum mainnet archive RPC for the hotline's purchase lookup and scripts/build-emax.mts
# RPC_URL=https://mainnet.gateway.tenderly.co

# CanaryRegistry on Sepolia (see contracts/README or contracts/deploy.mts)
CANARY_REGISTRY_ADDRESS=
CANARY_REGISTRY_FROM_BLOCK=0
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Key allowed to call anchorClaim (owner or relayer). Server-side only.
CANARY_RELAYER_KEY=

# Optional bearer token for the Chainlink watch list (GET /api/watch/snapshot?list=1). Unset = public list.
# When set, the canary-watch CRE workflow must send the same value: it reads it from the CRE secret
# WATCH_TOKEN (cre/secrets.yaml -> CANARY_WATCH_TOKEN in cre/.env; Vault DON when deployed).
# ?case=emax stays public either way.
# WATCH_TOKEN=

# Rate limits per IP per 10 minutes, and proxies in front of the app
# CASE_RUNS_PER_10_MIN=30
# RADAR_RUNS_PER_10_MIN=10
# TRUSTED_PROXY_HOPS=1
