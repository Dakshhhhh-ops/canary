# Canary — every variable is optional. Without keys the agents run on published rules and record gaps.

# AI arguments for the Bull/Bear/Judge (fact-guarded). Without it: rule-based agents.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# RYO market tools for the live radar (hackathon-issued key, starts with ryo_mcp_)
RYO_MCP_KEY=
# RYO_MCP_URL=https://app-ryochan.com/api/mcp

# Ethereum mainnet archive RPC for the hotline's purchase lookup and scripts/build-emax.mts
# RPC_URL=https://mainnet.gateway.tenderly.co

# CanaryRegistry on Sepolia (see contracts/README or contracts/deploy.mts)
CANARY_REGISTRY_ADDRESS=
CANARY_REGISTRY_FROM_BLOCK=0
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Key allowed to call anchorClaim (owner or relayer). Server-side only.
CANARY_RELAYER_KEY=

# Rate limits per IP per 10 minutes, and proxies in front of the app
# CASE_RUNS_PER_10_MIN=30
# RADAR_RUNS_PER_10_MIN=10
# TRUSTED_PROXY_HOPS=1
