# Copy to cre/.env (never commit .env).
# Private key of a Sepolia account with a little test ETH (64 hex chars, NO 0x prefix).
# The simulator signs/broadcasts the Sepolia write with it when you pass --broadcast.
CRE_ETH_PRIVATE_KEY=

# Value of the WATCH_TOKEN secret (cre/secrets.yaml) that canary-watch sends as "Authorization: Bearer …"
# when it fetches the watch list (local-settings, production-settings). Must equal the app's WATCH_TOKEN.
# Leave it empty for a public fetch; the line must still exist, because the simulator wants every
# secret's variable to be defined.
CANARY_WATCH_TOKEN=
